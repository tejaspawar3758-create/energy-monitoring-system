# GEMINI_API_KEY: Required for Gemini AI API calls (notebook digitizer).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL after deploy (optional).
APP_URL="MY_APP_URL"

# DATABASE_URL: Neon Postgres connection string (required on Vercel so all
# browsers share the same campus data). Leave empty for local file storage
# in data/campus-state.json during npm run dev.
DATABASE_URL=""
